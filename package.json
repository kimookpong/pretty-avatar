{
  "name": "pretty-avatar",
  "version": "0.1.1",
  "description": "A cute avatar that turns its head toward the cursor and reacts when you poke it.",
  "license": "MIT",
  "author": "kimookpong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimookpong/pretty-avatar.git"
  },
  "keywords": [
    "avatar",
    "mascot",
    "react",
    "cursor",
    "sprite",
    "portfolio"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "README.th.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && npm run sync:skill",
    "build:site": "npm run check:skill && npm run check:collection && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "sync:skill": "node scripts/sync-skill.mjs",
    "check:skill": "node scripts/sync-skill.mjs --check",
    "samples": "python3 scripts/samples.py",
    "test:pipeline": "python3 -m unittest discover -s tests -v",
    "prepack": "npm run build",
    "sync:collection": "node scripts/sync-collection.mjs",
    "check:collection": "node scripts/sync-collection.mjs --check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
